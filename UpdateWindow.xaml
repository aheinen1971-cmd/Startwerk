<Window x:Class="Startwerk.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Startwerk · Updates" Width="700" Height="620" MinWidth="620" MinHeight="570" Background="#10151F" Foreground="#EDF2FA" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="STARTWERK UPDATES" Foreground="#6EE7C2" FontWeight="Bold"/><TextBlock x:Name="VersionLabel" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,18"/></StackPanel>
  <StackPanel x:Name="SettingsPanel" Grid.Row="1"><TextBlock Text="GitHub-Projekt" Margin="0,0,0,8"/><TextBox x:Name="Repository"/><TextBlock Text="Öffentliche, stabile Releases. Nur mit dem Startwerk-Updateschlüssel signierte Versionen werden akzeptiert." TextWrapping="Wrap" Foreground="#9DAEC5" Margin="0,8,0,16"/><CheckBox x:Name="AutoCheck" Foreground="#C8D5E6" Content="Beim Start automatisch nach Updates suchen" Margin="0,0,0,12"/><CheckBox x:Name="AutoInstall" Foreground="#C8D5E6" Content="Updates automatisch laden und im Leerlauf installieren" Margin="0,0,0,16"/></StackPanel>
  <WrapPanel Grid.Row="2"><Button Content="Speichern" x:Name="SaveButton" Click="Save"/><Button Content="Jetzt prüfen" x:Name="CheckButton" Click="Check"/><Button Content="Update installieren" x:Name="InstallButton" Click="Install" IsEnabled="False" Background="#147A64"/></WrapPanel>
  <TextBlock Grid.Row="3" x:Name="Status" Foreground="#9DAEC5" Margin="0,16,0,0" TextWrapping="Wrap"/>
  <ProgressBar Grid.Row="4" x:Name="Progress" Height="5" Margin="0,14,0,12" BorderThickness="0" Background="#243247" Foreground="#6EE7C2"/>
  <TextBox Grid.Row="5" x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C1119" FontSize="12"/>
  <TextBlock Grid.Row="6" Text="Zur Installation startet Startwerk neu. Laufende Brenn-, USB- und Sicherungsvorgänge müssen vorher beendet sein." TextWrapping="Wrap" Foreground="#9DAEC5" Margin="0,12,0,0"/>
 </Grid>
</Window>
