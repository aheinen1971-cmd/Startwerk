<Window x:Class="Startwerk.IsoDownloadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Startwerk · Original-ISO herunterladen" Width="1120" Height="900" MinWidth="900" MinHeight="760" Background="#10151F" Foreground="#EDF2FA" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ORIGINAL-ISOS" Foreground="#6EE7C2" FontWeight="Bold"/><TextBlock Text="Windows und Linux direkt vom Anbieter." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,18"/></StackPanel>
  <StackPanel Grid.Row="1" x:Name="Options">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged"><ComboBoxItem Content="Windows · Download-Assistent"/></ComboBox><Button Grid.Column="1" x:Name="FindButton" Content="Erneut prüfen" Click="FindLatest" Margin="12,0,0,0"/></Grid>
   <TextBlock x:Name="Description" Foreground="#9DAEC5" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <StackPanel x:Name="WindowsOptions">
    <WrapPanel Margin="0,0,0,12"><Button Content="Download-Assistent" Click="ShowWizard"/><Button Content="Microsoft-Seite (Alternative)" Click="ShowMicrosoft"/></WrapPanel>
    <StackPanel x:Name="AlternativeOptions" Visibility="Collapsed">
    <TextBlock Text="Microsoft-SHA-256 (optional, von der Microsoft-Seite übernehmen)" Margin="0,0,0,6"/><TextBox x:Name="ExpectedHash" FontSize="12"/>
    <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MicrosoftLink" ToolTip="Alternativ einen frischen Microsoft-ISO-Link einfügen" FontSize="12"/><Button Grid.Column="1" Content="Microsoft-Seite im Browser" Click="OpenMicrosoft" Margin="10,0,0,0"/></Grid>
    </StackPanel>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="2">
   <Border x:Name="BrowserBorder" Visibility="Hidden" BorderBrush="#3A4B63" BorderThickness="1"><ContentControl x:Name="BrowserSlot"/></Border>
   <Border x:Name="WizardBorder" Background="#1B2534" CornerRadius="8" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="WINDOWS-DOWNLOAD-ASSISTENT" Foreground="#6EE7C2" FontWeight="Bold"/>
     <TextBlock Text="1 · Windows und Zielarchitektur" FontSize="19" Margin="0,14,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox IsEnabled="False" SelectedIndex="0" Margin="0,0,12,0"><ComboBoxItem Content="Windows 11 · aktuelle Microsoft-Ausgabe"/></ComboBox>
      <ComboBox x:Name="WindowsArchitecture" Grid.Column="1" SelectedIndex="0" SelectionChanged="ArchitectureChanged"><ComboBoxItem Content="Intel / AMD · 64 Bit (x64)"/><ComboBoxItem Content="ARM · 64 Bit (Arm64)"/></ComboBox>
     </Grid>
     <Button x:Name="LoadWindowsButton" Content="Microsoft-Auswahl laden" Click="LoadWindows" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <TextBlock Text="2 · Edition wählen" FontSize="19" Margin="0,20,0,8"/>
     <ComboBox x:Name="WindowsEdition" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="EditionChanged"/>
     <Button x:Name="LanguageButton" Content="Sprachen laden" Click="LoadLanguages" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     <TextBlock Text="3 · Sprache wählen" FontSize="19" Margin="0,20,0,8"/>
     <ComboBox x:Name="WindowsLanguage" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="LanguageChanged"/>
     <Button x:Name="WindowsLinkButton" Content="Offiziellen Download vorbereiten" Click="PrepareWindows" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     <TextBlock x:Name="WindowsReview" Text="Editionen und Sprachen werden frisch über das öffentliche Microsoft-Formular geladen. Erst nach deiner Auswahl wird eine ISO gespeichert." TextWrapping="Wrap" Foreground="#C8D5E6" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border x:Name="LinuxInfo" Background="#1B2534" CornerRadius="8" Padding="24" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="LINUX-DOWNLOAD-ASSISTENT" Foreground="#6EE7C2" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseInfo" Text="Die aktuelle Veröffentlichung wird automatisch geprüft." FontSize="20" Margin="0,16,0,14" TextWrapping="Wrap"/><TextBlock x:Name="SourceInfo" Foreground="#9DAEC5" TextWrapping="Wrap"/><Button x:Name="DistroPageButton" Content="Offizielle Downloadseite öffnen" Click="OpenDistroPage" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    <StackPanel x:Name="AlternativeSources" Visibility="Collapsed" Margin="0,20,0,0"><TextBlock Text="ALTERNATIVE DOWNLOADSEITEN" Foreground="#6EE7C2" FontWeight="Bold" Margin="0,0,0,8"/><ComboBox x:Name="AlternativeSource" SelectionChanged="AlternativeSourceChanged"/><TextBlock x:Name="AlternativeNote" TextWrapping="Wrap" Foreground="#C8D5E6" Margin="0,10,0,10"/><Button Content="Alternative Downloadseite öffnen" Click="OpenAlternativeSource" HorizontalAlignment="Left"/></StackPanel>
    <TextBlock x:Name="LinuxVerification" Text="Offizielle Prüfsumme suchen → Speicherort wählen → herunterladen und prüfen. USB-Schreiben bleibt ein eigener Schritt." TextWrapping="Wrap" Foreground="#C8D5E6" Margin="0,24,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="DownloadButton" Content="ISO herunterladen …" Click="DownloadClick" Background="#147A64" IsEnabled="False"/><Button x:Name="CancelButton" Content="Download abbrechen" Click="Cancel" IsEnabled="False"/><TextBlock x:Name="Status" Foreground="#9DAEC5" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
  <ProgressBar x:Name="Progress" Grid.Row="4" Height="6" Margin="0,12,0,10" BorderThickness="0" Background="#243247" Foreground="#6EE7C2"/>
  <TextBox Grid.Row="5" x:Name="Log" Height="85" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Background="#0C1119"/>
 </Grid>
</Window>
