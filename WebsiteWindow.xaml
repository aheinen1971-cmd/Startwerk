<Window x:Class="Startwerk.WebsiteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Startwerk · Webseiten prüfen" Width="1080" Height="700" MinWidth="850" MinHeight="560" Background="#10151F" Foreground="#EDF2FA" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="WEBSEITEN UND QUELLEN" Foreground="#6EE7C2" FontWeight="Bold"/><TextBlock Text="Bekannte Anbieter. Geprüfte Adressen." FontSize="26" Margin="0,8,0,12"/><TextBlock Text="Automatische Prüfung alle 6 Stunden, solange Startwerk geöffnet ist. Überfällige Prüfungen werden beim Start nachgeholt. Vor dem Öffnen einer Downloadseite wird die Adresse zusätzlich erneut geprüft." TextWrapping="Wrap" Foreground="#C8D5E6"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,18,0,14"><Button x:Name="CheckNow" Content="Jetzt erneut prüfen" Click="RefreshClick"/><TextBlock x:Name="Schedule" VerticalAlignment="Center" Foreground="#9DAEC5" TextWrapping="Wrap"/></WrapPanel>
  <DataGrid x:Name="Rows" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#1B2534" Foreground="#10151F" EnableRowVirtualization="True" SelectionChanged="ShowSelected">
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Restricted"><Setter Property="Background" Value="#FFF2CC"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Blocked"><Setter Property="Background" Value="#FFDADA"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Unavailable"><Setter Property="Background" Value="#FFDADA"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns><DataGridTextColumn Header="Anbieter" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Ergebnis" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="Zuletzt geprüft" Binding="{Binding Checked}" Width="125"/><DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="230"/><DataGridTextColumn Header="Hinweis" Binding="{Binding Message}" Width="*" MinWidth="260"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="Details" Grid.Row="3" Text="Verbindungsfehler werden einmal an der bekannten Originaladresse erneut geprüft. Fremde Weiterleitungen und Zertifikatsfehler werden nicht freigegeben. Die Prüfung bestätigt Domain und HTTPS, nicht sämtliche Inhalte einer Webseite." Foreground="#9DAEC5" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid>
</Window>
